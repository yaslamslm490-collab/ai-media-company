# Never commit real values. Configure Production values as protected WebDev secrets.
# Recovery fingerprint HMAC key: generate a random value locally; never commit it.
OWNER_PHONE_NUMBER_PRIMARY=
# JSON array of up to five backup numbers, e.g. [] (never commit actual numbers).
OWNER_PHONE_NUMBERS_BACKUP=
OWNER_RECOVERY_HMAC_KEY=
# Long, randomly generated, single-use emergency recovery value; rotate after use.
OWNER_RECOVERY_CODE=

# Twilio Verify: use an API Key/Secret (not the account Auth Token) and a Verify Service.
# Configure the Verify Service for six-digit codes.
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_VERIFY_SERVICE_SID=

# Optional integration health probes. Set only URLs and credentials you own.
AI_ROUTER_HEALTH_URL=
AI_ROUTER_BASE_URL=
AI_ROUTER_CHAT_COMPLETIONS_URL=
AI_ROUTER_API_KEY=
AI_ROUTER_MODEL=
MANUS_HEALTH_URL=
MANUS_API_TOKEN=
# An API key supplied through the Manus API connector can be injected as MANUS_API_KEY.
MANUS_API_KEY=
GITHUB_HEALTH_URL=https://api.github.com/user
GITHUB_TOKEN=
# Opt in to probing the host's authenticated gh CLI account instead of storing a token.
GITHUB_USE_CLI=false
# Optional JSON object mapping integration names to a GET health URL.
EXTERNAL_HEALTH_URLS=

# Fernet key for encryption at rest of external-account API credentials.
# Generate or validate it locally with: python3 scripts/init_vault.py
AI_MEDIA_VAULT_KEY=

HOST=127.0.0.1
PORT=8080
