# Generate a private value locally; never commit your real .env file.
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
OWNER_API_TOKEN=
OWNER_MASTER_PASSWORD=

# Optional integration health probes. Set only URLs and credentials you own.
AI_ROUTER_HEALTH_URL=
AI_ROUTER_BASE_URL=
AI_ROUTER_CHAT_COMPLETIONS_URL=
AI_ROUTER_API_KEY=
AI_ROUTER_MODEL=
MANUS_HEALTH_URL=
MANUS_API_TOKEN=
# An API key supplied through the Manus API connector can be injected as MANUS_API_KEY.
MANUS_API_KEY=
# Legacy bearer compatibility only. OAuth 2.1 is preferred for remote MCP clients.
NADA_MCP_TOKEN=
# Optional canonical HTTPS origin for a custom domain. Render's RENDER_EXTERNAL_URL is used by default.
PUBLIC_BASE_URL=
# RENDER_EXTERNAL_URL is injected automatically by Render; do not set it manually there.
# Optional cached Manus webhook public key (normally fetched server-side from Manus API).
MANUS_WEBHOOK_PUBLIC_KEY=
GITHUB_HEALTH_URL=https://api.github.com/user
GITHUB_TOKEN=
# Opt in to probing the host's authenticated gh CLI account instead of storing a token.
GITHUB_USE_CLI=false
# Optional JSON object mapping integration names to a GET health URL.
EXTERNAL_HEALTH_URLS=

# Fernet key for encryption at rest of external-account API credentials.
# Generate or validate it locally with: python3 scripts/init_vault.py
AI_MEDIA_VAULT_KEY=

HOST=127.0.0.1
PORT=8080
