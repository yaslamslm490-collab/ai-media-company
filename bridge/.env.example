# Copy to bridge/.env. Never commit bridge/.env or paste real secrets into chat.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
BRIDGE_API_TOKEN=

# Create this key in Manus Developer/API settings, then store it only on the bridge host.
MANUS_API_KEY=

# Optional: comma-separated Manus connector UUIDs. Leave blank to use enabled defaults.
# GitHub connector UUID in Manus: bbb0df76-66bd-4a24-ae4f-2aac4750d90b
MANUS_CONNECTOR_IDS=
# Optional Manus Project ID for persistent project instructions.
MANUS_PROJECT_ID=
MANUS_LOCALE=ar

# Public HTTPS origin after deployment; used to register and verify Manus webhooks.
BRIDGE_PUBLIC_URL=https://bridge.example.com

# Local/container settings. Mount /data persistently for SQLite.
BRIDGE_DB_PATH=/data/manus_bridge.sqlite3
HOST=0.0.0.0
PORT=8123
